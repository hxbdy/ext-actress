{
  "manifest_version": 3,
  "name": "DMM Cast Auto-Filler",
  "version": "1.3",
  "permissions": ["declarativeNetRequest"],
  "host_permissions": [
    "https://video.dmm.co.jp/*",
    "https://av-wiki.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://video.dmm.co.jp/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}